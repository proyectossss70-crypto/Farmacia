# Copia este archivo a  .env  y ajusta los valores.
# (El proyecto NO carga .env automáticamente; exporta las variables o usa: node --env-file=.env server.js)

# Puerto del servidor web
PORT=3000

# Secreto para firmar las sesiones (usa una cadena larga y aleatoria en producción)
SESSION_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# --- Base de datos ---
# Sin configurar nada -> usa SQLite local (data/farmacia.db)
# Con credenciales de Firebase -> usa Firestore automáticamente
# Forzar uno u otro: DB_DRIVER=sqlite  |  DB_DRIVER=firestore
# DB_DRIVER=firestore

# --- Firebase / Firestore ---
# Opción A: ruta al archivo de credenciales de la cuenta de servicio
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
#
# Opción B: el JSON completo de la cuenta de servicio en una sola línea
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}
